{
  "name": "quantscope-backend",
  "version": "1.0.0",
  "private": true,
  "description": "QuantScope API — building quantity calculation backend",
  "type": "module",
  "workspaces": [
    "packages/calculation-engine"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:engine": "npm run test --workspace=packages/calculation-engine",
    "db:generate": "node scripts/with-database-url.mjs generate",
    "db:push": "node scripts/with-database-url.mjs db push",
    "db:studio": "node scripts/with-database-url.mjs studio",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@auto-measure/calculation-engine": "*",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
