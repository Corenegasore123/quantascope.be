{
  "name": "quantscope-backend",
  "version": "1.0.0",
  "private": true,
  "description": "QuantScope API — building quantity calculation backend",
  "type": "module",
  "workspaces": [
    "packages/calculation-engine"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:engine": "npm run test --workspace=packages/calculation-engine",
    "db:generate": "node scripts/with-database-url.mjs generate",
    "db:push": "node scripts/with-database-url.mjs db push",
    "db:studio": "node scripts/with-database-url.mjs studio"
  },
  "dependencies": {
    "@auto-measure/calculation-engine": "*",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
