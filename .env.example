# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=automeasure
DB_SCHEMA=public

# API Server
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_MAX_AGE_DAYS=30

# Dev seed (optional)
SEED_ADMIN_EMAIL=admin@quantscope.local
SEED_ADMIN_PASSWORD=Admin123!

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# Confidence Thresholds
CONFIDENCE_AUTO_ACCEPT=0.95
CONFIDENCE_FLAG=0.80

# Computer Vision Service
CV_SERVICE_URL=http://localhost:8000
CV_OCR_PROVIDER=tesseract
CV_TIMEOUT_MS=120000
CV_RETRY_ATTEMPTS=2
CV_MIN_MEASUREMENT_CONFIDENCE=0.50
CV_FALLBACK_PREPROCESSING=true
ALLOW_MOCK_CV=false

# Redis / Job Queue (set REDIS_ENABLED=false to process inline without a worker)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_MIN=120
UPLOAD_RATE_LIMIT_PER_HOUR=30

# Public API URL (used in upload intent responses)
API_PUBLIC_URL=http://localhost:4000

# Tesseract (Windows example)
# CV_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
