# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=automeasure
DB_SCHEMA=public

# API Server
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_MAX_AGE_DAYS=30

# Dev seed (optional)
SEED_ADMIN_EMAIL=admin@quantscope.local
SEED_ADMIN_PASSWORD=Admin123!

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# Confidence Thresholds
CONFIDENCE_AUTO_ACCEPT=0.95
CONFIDENCE_FLAG=0.80

# Computer Vision Service
CV_SERVICE_URL=http://localhost:8000
CV_OCR_PROVIDER=tesseract
ALLOW_MOCK_CV=false

# Tesseract (Windows example)
# CV_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
